# Copy to docker-compose.override.yml for local hot-reload development.
# Compose merges this automatically with docker-compose.yml when present.
# This file is gitignored so each developer can customise without affecting others.

services:
  backend:
    volumes:
      - ../backend/app:/app/app
    command: ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]

  frontend:
    build:
      target: build
    volumes:
      - ../frontend/src:/app/src
    command: ["npm", "run", "dev", "--", "--host"]
    ports:
      - "5173:5173"
