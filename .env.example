# Copy this file to .env and fill in values. Never commit the real .env file.

# --- General ---
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO

# --- Backend (FastAPI) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# --- Database ---
# Prototype phase: JSON file storage, no connection needed.
DATABASE_MODE=json               # json | postgres
DATABASE_URL=postgresql://user:password@localhost:5432/dcih
# Least-privilege, read-only role used only by the LLM query layer (Phase 6).
DATABASE_URL_READONLY=postgresql://readonly:password@localhost:5432/dcih

# --- AusTender ingestion (Phase 1+) ---
AUSTENDER_API_BASE_URL=https://api.tenders.gov.au/ocds/
RAW_STORE_PATH=./data/raw
AUSTENDER_POLITENESS_DELAY_MS=250
AUSTENDER_MAX_RETRIES=5

# --- LLM query layer (Phase 6) ---
ANTHROPIC_API_KEY=
LLM_MAX_ROWS=1000
LLM_STATEMENT_TIMEOUT_MS=10000
THEME_LLM_VALUE_THRESHOLD=

# --- External intelligence / news (Phase 8) ---
NEWS_FETCH_USER_AGENT=
NEWS_MIN_REQUEST_INTERVAL_MS=2000
NEWS_EXTRACT_MAX_WORDS=40
NEWS_RELEVANCE_FLOOR=0.35
NEWS_LINKAGE_CONFIDENCE_FLOOR=0.75
REPORT_TIMEZONE=Australia/Sydney

# --- Capability-match & report embeddings ---
EMBEDDING_BACKEND=openai          # openai | local | voyage | none
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=1024
DOC_CHUNK_TARGET_TOKENS=600
DOC_RETRIEVAL_MAX_CHUNKS=12

# --- AI providers (legacy prototype abstraction; Phase 6 replaces with Anthropic) ---
AI_PROVIDER=ollama                # ollama | openai | azure_openai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-06-01

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- Feature flags ---
FEATURE_AGENT_ORCHESTRATION=true
FEATURE_EXECUTIVE_SUMMARY=true
