# --- Raw ingested data (audit archive; local stand-in for Azure Blob) ---
# Never commit raw AusTender payloads or harvested news (they live under backend/data
# at runtime). Test fixtures live under tests/.
data/raw/
data/news_raw/
backend/data/
**/data/raw/
**/data/news_raw/

# --- Local Claude Code settings (per-machine) ---
.claude/settings.local.json

# --- Database ---
*.sqlite3
*.db
postgres-data/

# --- Ollama / local model artefacts ---
.ollama/

# --- IDE / OS ---
.DS_Store
Thumbs.db
.idea/
*.swp

